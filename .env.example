# =====================================================================
# Swish Compliance — environment configuration
# Copy this file to `.env.local` for local dev, or set these in Railway.
# =====================================================================

# --- REQUIRED ---------------------------------------------------------

# PostgreSQL connection string.
# On Railway: add a Postgres plugin and reference its DATABASE_URL:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/swish_compliance

# Secret used to sign session JWT cookies. MUST be >= 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- OPTIONAL ---------------------------------------------------------

# Node environment. Set to 'production' on hosted deploys (enables secure
# cookies and disables Vite/Next dev tooling).
NODE_ENV=development

# Bootstrap admin user — used ONLY by `npm run db:migrate` when the users
# table is empty. After the first login, change the password from the UI
# (or insert your real users directly).
ADMIN_EMAIL=admin@swish.local
ADMIN_PASSWORD=admin123
